# 构建产物（可由 pack.ps1 重新生成，体积大，不进 git）
dist/
dist-new/
sfx/out/

# 私钥与签发工具：永不进版本库（防未来误推送泄露）
seller-keys/

# 编辑器/系统杂项
*.bak
Thumbs.db
Desktop.ini

# 运行时产物（安装目录不在这里，但源码目录偶尔会掉落）
app/licence.json
app/licence.state.json
app/ultra-usage.json
# 7 天试用的本机锚点（trial.ps1 在源码目录跑一次就会生成；每台机器不同，绝不进版本库）
app/trial.json
# 机械码缓存（机器不同、不进版本库）
app/machine.id
app/machine.legacy.id
# 高性能模式组件（32MB 二进制，不进版本库；打包时从本地放回 app\ 即可）
app/Sunshine-Windows-AMD64-installer.msi
# 网页端 H.264 组件（约 100MB 二进制，不进版本库）
app/bin/ffmpeg.exe
# 本地工具链与构建产物（不进仓库）
tools/
app/rtc-h264/*.exe
app/rtc-h264/*.bin
app/rtc-h264/sidecar.out
app/bin/win-capture.exe
app/bin/sources.exe

# release 打包的临时目录（staging 副本 + 中间产物，体积大，不进 git）
_release/
.release/
.release/
app/exp/ocr/srv.out
app/exp/ocr/srv.err
app/exp/**/__pycache__/
app/exp/**/*.pyc
